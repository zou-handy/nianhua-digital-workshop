page {
  background-color: #0a0a14;
}

.viewer-page {
  width: 100vw;
  height: 100vh;
  position: relative;
  overflow: hidden;
  background: #0a0a14;
}

/* 悬浮返回按钮 */
.float-back-btn {
  position: fixed;
  top: 40rpx;
  left: 30rpx;
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 150;
}

.float-back-btn:active {
  background: rgba(255, 255, 255, 0.4);
}

.float-back-icon {
  color: #fff;
  font-size: 38rpx;
  font-weight: bold;
}

/* 底部模型名称 */
.model-name-bar {
  position: absolute;
  bottom: calc(env(safe-area-inset-bottom, 0px) + 100rpx);
  left: 0;
  width: 100%;
  text-align: center;
  z-index: 100;
}

.model-name-row {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
}

.model-name-text {
  color: #F8E5A9;
  font-size: 30rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

/* 模型AI生成标识小徽章 */
.model-ai-tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: linear-gradient(135deg, rgba(196, 30, 58, 0.9), rgba(230, 168, 23, 0.9));
  color: #fff7e6;
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 顶部AI生成内容显著标识 */
.ai-generated-badge {
  position: fixed;
  top: calc(env(safe-area-inset-top, 0px) + 40rpx);
  right: 30rpx;
  z-index: 150;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  pointer-events: none;
}

.ai-generated-tag {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, rgba(196, 30, 58, 0.95), rgba(230, 168, 23, 0.95));
  color: #fff7e6;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: 0 4rpx 16rpx rgba(196, 30, 58, 0.4);
}

.ai-generated-text {
  font-size: 20rpx;
  color: rgba(248, 229, 169, 0.9);
  background: rgba(0, 0, 0, 0.45);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  letter-spacing: 1rpx;
}

.procedural-generated-badge {
  position: fixed;
  top: calc(env(safe-area-inset-top, 0px) + 40rpx);
  right: 30rpx;
  z-index: 150;
  pointer-events: none;
}

.procedural-generated-tag,
.model-procedural-tag {
  display: inline-flex;
  align-items: center;
  padding: 5rpx 14rpx;
  color: #fff7e6;
  font-size: 19rpx;
  background: rgba(111, 67, 37, 0.9);
  border: 1rpx solid rgba(215, 165, 61, 0.55);
  border-radius: 4rpx;
}

/* 底部提示 */
.hint-bar {
  position: absolute;
  bottom: calc(env(safe-area-inset-bottom, 0px) + 40rpx);
  left: 0;
  width: 100%;
  text-align: center;
  z-index: 100;
}

.hint-text {
  color: rgba(255, 255, 255, 0.35);
  font-size: 24rpx;
  letter-spacing: 4rpx;
  background: rgba(0, 0, 0, 0.3);
  padding: 12rpx 40rpx;
  border-radius: 30rpx;
}

/* 加载遮罩 */
.loading-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(10, 10, 20, 0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(248, 229, 169, 0.2);
  border-top-color: #F8E5A9;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 30rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: rgba(248, 229, 169, 0.6);
  font-size: 26rpx;
  letter-spacing: 4rpx;
}
