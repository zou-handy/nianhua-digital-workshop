<view class="container">
  <view class="header">
    <view class="title-row">
      <text class="title">AI 图片生成 3D 模型</text>
      <view class="ai-tag">AI生成</view>
    </view>
    <text class="subtitle">上传一张图片，AI 自动生成 3D 模型</text>
  </view>

  <!-- AI生成内容显著标识 -->
  <view class="ai-notice-bar">
    <text class="ai-notice-text">本页 3D 模型由人工智能（AI）生成，仅供参考</text>
  </view>

  <!-- 图片选择区域 -->
  <view class="upload-area" bindtap="chooseImage">
    <image wx:if="{{imagePath}}" src="{{imagePath}}" mode="aspectFit" class="preview-image"/>
    <view wx:else class="upload-placeholder">
      <text class="upload-icon">+</text>
      <text class="upload-text">点击选择图片</text>
    </view>
  </view>

  <!-- 生成按钮 -->
  <button
    class="generate-btn {{(!imagePath || loading) ? 'disabled' : ''}}"
    bindtap="generate3D"
    disabled="{{!imagePath || loading}}"
  >
    <text wx:if="{{loading}}">{{loadingText}}</text>
    <text wx:else>生成 3D 模型</text>
  </button>

  <!-- 状态提示 -->
  <view wx:if="{{loading}}" class="status-area">
    <view class="loading-spinner"></view>
    <text class="status-text">{{loadingText}}</text>
    <text class="status-hint">通常需要约 10 分钟，复杂任务可能更久</text>
  </view>

  <!-- 历史生成 -->
  <view wx:if="{{modelHistory.length > 0}}" class="history-section">
    <text class="history-title">历史生成</text>
    <view
      wx:for="{{modelHistory}}"
      wx:key="path"
      class="history-item"
      bindtap="viewHistoryModel"
      data-index="{{index}}"
    >
      <image
        wx:if="{{item.thumbnailPath}}"
        class="history-thumbnail"
        src="{{item.thumbnailPath}}"
        mode="aspectFill"
      ></image>
      <view class="history-info">
        <view class="history-name-row">
          <text class="history-name">{{item.name}}</text>
          <view class="history-ai-tag">AI生成</view>
        </view>
        <text class="history-time">{{item.time}}</text>
      </view>
      <text class="history-arrow">›</text>
    </view>
  </view>
</view>
