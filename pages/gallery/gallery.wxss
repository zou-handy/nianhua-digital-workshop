page {
  background-color: #1a1a2e;
}

.container {
  min-height: 100vh;
  padding: 40rpx;
  box-sizing: border-box;
}

.header {
  position: relative;
  text-align: center;
  margin-bottom: 60rpx;
  padding-top: 20rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 900;
  color: #F8E5A9;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.card {
  width: 48%;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 32rpx 0;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card:active {
  background: rgba(255, 255, 255, 0.12);
}

.card-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.emoji {
  font-size: 80rpx;
  line-height: 1;
}

.card-thumbnail {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}

.card-name {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
}

.ai-entry {
  display: flex;
  align-items: center;
  margin: 20rpx 30rpx 30rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, rgba(196, 30, 58, 0.15), rgba(212, 168, 73, 0.15));
  border: 1rpx solid rgba(212, 168, 73, 0.3);
  border-radius: 20rpx;
}

.ai-entry-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
}

.ai-entry-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.ai-entry-title {
  color: #F8E5A9;
  font-size: 30rpx;
  font-weight: 700;
}

.ai-entry-desc {
  color: rgba(255, 255, 255, 0.5);
  font-size: 22rpx;
  margin-top: 6rpx;
}

.ai-entry-arrow {
  color: rgba(248, 229, 169, 0.6);
  font-size: 36rpx;
}

.back-btn {
  position: absolute;
  left: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.back-icon {
  color: #fff;
  font-size: 36rpx;
}
