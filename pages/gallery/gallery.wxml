<view class="container">
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    <text class="title">3D 年画展厅</text>
    <text class="subtitle">点击模型进入3D查看</text>
  </view>

  <!-- AI生成入口 -->
  <view class="ai-entry" bindtap="goAI3D">
    <view class="ai-entry-icon"></view>
    <view class="ai-entry-text">
      <text class="ai-entry-title">AI 生成 3D 模型</text>
      <text class="ai-entry-desc">上传年画图片，AI自动生成3D模型</text>
    </view>
    <text class="ai-entry-arrow">→</text>
  </view>

  <view class="grid">
    <view class="card" wx:for="{{models}}" wx:key="id" bindtap="onModelTap" data-item="{{item}}">
      <view class="card-icon" style="background-color: {{item.color}};">
        <image
          wx:if="{{item.thumbnailPath}}"
          class="card-thumbnail"
          src="{{item.thumbnailPath}}"
          mode="aspectFill"
        ></image>
        <text wx:else class="emoji">{{item.emoji}}</text>
      </view>
      <text class="card-name">{{item.name}}</text>
    </view>
  </view>
</view>
