page {
  width: 100%;
  height: 100%;
  background: #0f0805;
  overflow: hidden;
}

.page-root {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  position: relative;
  background: #0f0805;
}

.global-bg-art {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
  opacity: 0.42;
  filter: saturate(0.72) sepia(0.14) contrast(1.06);
  pointer-events: none;
}

.global-paper-grain {
  position: fixed;
  inset: 0;
  z-index: 1;
  background:
    repeating-linear-gradient(8deg, rgba(255, 242, 210, 0.025) 0 1rpx, transparent 1rpx 7rpx),
    repeating-linear-gradient(96deg, rgba(67, 33, 18, 0.035) 0 1rpx, transparent 1rpx 11rpx);
  pointer-events: none;
}

.global-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1;
  background:
    radial-gradient(circle at 52% 36%, rgba(84, 44, 24, 0.08) 0%, rgba(15, 8, 5, 0.5) 68%, rgba(10, 5, 3, 0.78) 100%),
    linear-gradient(180deg, rgba(15, 8, 5, 0.38) 0%, rgba(15, 8, 5, 0.66) 100%);
  pointer-events: none;
}

.opening-effect-video {
  position: absolute;
  top: calc(1.672vw + 10.2vh);
  left: 9.516vw;
  z-index: 19;
  width: 77.968vw;
  height: 54.145vw;
  opacity: 0;
  background: transparent;
  pointer-events: none;
  transition: opacity 180ms ease-out;
}

.opening-effect-video.is-playing {
  opacity: 1;
}

.volume-transition {
  position: fixed;
  inset: 0;
  z-index: 18;
  pointer-events: none;
  overflow: hidden;
  animation: volumeTransitionFade 1.25s ease-out both;
}

.volume-transition-ink,
.volume-transition-vermilion,
.volume-transition-gold,
.volume-transition-cut {
  position: absolute;
  inset: -12%;
}

.volume-transition-ink {
  background: linear-gradient(155deg, rgba(9, 5, 3, 0.98) 0%, rgba(36, 18, 10, 0.82) 44%, rgba(9, 5, 3, 0) 72%);
  transform-origin: left bottom;
  animation: volumeInkSweep 1.08s cubic-bezier(0.22, 0.8, 0.24, 1) both;
}

.volume-transition-vermilion {
  background: linear-gradient(118deg, rgba(196, 30, 58, 0) 24%, rgba(196, 30, 58, 0.72) 48%, rgba(112, 12, 25, 0) 69%);
  transform: translateX(-58%) skewX(-12deg);
  animation: volumeVermilionSweep 1.12s cubic-bezier(0.2, 0.74, 0.25, 1) 0.08s both;
}

.volume-transition-gold {
  inset: 0;
  background: linear-gradient(180deg, rgba(230, 168, 23, 0) 28%, rgba(230, 168, 23, 0.38) 50%, rgba(230, 168, 23, 0) 70%);
  transform: translateY(-72%);
  animation: volumeGoldTrace 0.9s ease-out 0.2s both;
}

.volume-transition-cut {
  inset: 0;
  background: linear-gradient(90deg, rgba(255, 247, 230, 0) 0%, rgba(255, 247, 230, 0.2) 50%, rgba(255, 247, 230, 0) 100%);
  transform: translateY(100%) scaleY(0.012);
  animation: volumePaperCut 0.76s ease-out 0.24s both;
}

@keyframes volumeInkSweep {
  0% { opacity: 0; transform: translate(-28%, 32%) rotate(-8deg) scale(1.25); }
  32% { opacity: 1; }
  72% { opacity: 0.9; transform: translate(3%, -2%) rotate(0) scale(1); }
  100% { opacity: 0; transform: translate(26%, -24%) rotate(5deg) scale(1.08); }
}

@keyframes volumeVermilionSweep {
  0% { opacity: 0; transform: translateX(-62%) skewX(-12deg); }
  46% { opacity: 1; }
  100% { opacity: 0; transform: translateX(66%) skewX(-12deg); }
}

@keyframes volumeGoldTrace {
  0% { opacity: 0; transform: translateY(-72%); }
  50% { opacity: 1; }
  100% { opacity: 0; transform: translateY(72%); }
}

@keyframes volumePaperCut {
  0% { opacity: 0; transform: translateY(100%) scaleY(0.012); }
  45% { opacity: 0.8; }
  100% { opacity: 0; transform: translateY(-100%) scaleY(0.012); }
}

@keyframes volumeTransitionFade {
  0%, 76% { opacity: 1; }
  100% { opacity: 0; }
}

.main-swiper {
  position: relative;
  z-index: 2;
  width: 100vw;
  height: 100vh;
}

.screen {
