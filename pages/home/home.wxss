  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tool-modal-hero {
  position: relative;
  width: 100%;
  height: 52vh;
  min-height: 420rpx;
  max-height: 600rpx;
  flex: 0 0 auto;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: #120b06;
  border-bottom: 1rpx solid rgba(215, 165, 61, 0.24);
}

.tool-modal-img {
  width: 96%;
  height: 0;
  min-height: 0;
  flex: 1;
  opacity: 1;
  margin: 0 auto;
  background: #120b06;
}

.tool-modal-banner {
  position: relative;
  width: 100%;
  min-height: 76rpx;
  padding: 12rpx 104rpx 12rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: rgba(18, 11, 6, 0.86);
  border-left: 5rpx solid #d7a53d;
}

.tool-modal-banner-name {
  flex: 0 0 auto;
  font-size: 30rpx;
  color: #fff7e6;
  font-weight: 600;
  font-family: "STXingkai", "华文行楷", "FZKai-Z03", "KaiTi", cursive;
}

.tool-modal-banner-purpose {
  min-width: 0;
  color: rgba(255, 247, 230, 0.62);
  font-size: 21rpx;
  line-height: 1.4;
}

.tool-modal-body {
  flex: 1;
  min-height: 0;
  height: 0;
  padding: 28rpx 36rpx 72rpx;
  box-sizing: border-box;
}

.tool-modal-spec-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(230, 168, 23, 0.15);
}

.tool-modal-spec {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  min-height: 62rpx;
  padding: 10rpx 14rpx;
  box-sizing: border-box;
  background: rgba(255, 247, 230, 0.04);
  border-left: 2rpx solid rgba(215, 165, 61, 0.32);
}

.spec-label {
  font-size: 18rpx;
  color: rgba(230, 168, 23, 0.6);
  letter-spacing: 3rpx;
}

.spec-value {
  font-size: 24rpx;
  color: #fff7e6;
  font-weight: 500;
  font-family: 'Courier New', monospace;
}

.tool-modal-desc {
  font-size: 24rpx;
  color: rgba(255, 247, 230, 0.75);
  line-height: 1.72;
  display: block;
}

.tool-modal-divider {
  height: 1rpx;
  background: rgba(230, 168, 23, 0.15);
  margin: 28rpx 0 24rpx;
}

.tool-modal-section-title {
  font-size: 22rpx;
  color: rgba(196, 30, 58, 0.8);
  letter-spacing: 4rpx;
  font-weight: 600;
