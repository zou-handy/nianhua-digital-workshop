  flex-direction: column;
  gap: 4rpx;
}

.tool-detail-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff7e6;
  letter-spacing: 3rpx;
}

.tool-detail-purpose {
  font-size: 20rpx;
  color: rgba(230, 168, 23, 0.7);
  letter-spacing: 2rpx;
}

.tool-detail-spec {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2rpx;
}

.tool-spec-line {
  font-size: 18rpx;
  color: rgba(255, 247, 230, 0.55);
