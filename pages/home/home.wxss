  margin-bottom: 12rpx;
}

.tool-modal-section-text {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 247, 230, 0.6);
  line-height: 1.75;
}

.tool-modal-back {
  width: 100%;
  height: 76rpx;
  margin-top: 30rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff7e6;
  font-size: 22rpx;
  background: rgba(143, 38, 52, 0.42);
  border: 1rpx solid rgba(196, 30, 58, 0.64);
  border-radius: 4rpx;
}

