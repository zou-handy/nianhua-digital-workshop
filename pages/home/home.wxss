  font-size: 40rpx;
  border: 1rpx solid rgba(255, 247, 230, 0.18);
}

.advanced-creator-notice {
  display: block;
  margin: 24rpx 0 16rpx;
  padding: 12rpx 16rpx;
  color: rgba(255, 247, 230, 0.58);
  font-size: 18rpx;
  background: rgba(215, 165, 61, 0.08);
  border-left: 3rpx solid #d7a53d;
}

.advanced-creator-input {
  width: 100%;
  min-height: 146rpx;
  padding: 20rpx;
  box-sizing: border-box;
  color: #fff7e6;
  font-size: 24rpx;
  line-height: 1.5;
  background: rgba(255, 247, 230, 0.05);
  border: 1rpx solid rgba(255, 247, 230, 0.18);
  border-radius: 4rpx;
}

.advanced-creator-commands {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 12rpx;
  margin-top: 16rpx;
}

.advanced-creator-btn,
.advanced-creator-split {
  width: 100%;
  margin: 0;
  border-radius: 4rpx;
  font-size: 22rpx;
}

.advanced-creator-btn-secondary {
  color: #fff7e6;
  background: rgba(255, 247, 230, 0.06);
  border: 1rpx solid rgba(255, 247, 230, 0.2);
}

.advanced-creator-btn-primary,
.advanced-creator-split {
  color: #fff7e6;
  background: #8f2634;
  border: 1rpx solid #ad3b48;
}

.advanced-creator-result {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(215, 165, 61, 0.18);
}

.advanced-creator-image {
  width: 100%;
  height: 430rpx;
  background: #f3e4c4;
}

.advanced-creator-split {
  margin-top: 14rpx;
}

.advanced-creator-working {
  margin-top: 20rpx;
  padding: 24rpx 20rpx 20rpx;
  text-align: center;
  background: rgba(7, 4, 2, 0.55);
  border: 1rpx solid rgba(215, 165, 61, 0.22);
}

.advanced-working-scene {
  position: relative;
  width: 300rpx;
  height: 190rpx;
  margin: 0 auto 16rpx;
}

.advanced-working-board {
  position: absolute;
  top: 54rpx;
  left: 104rpx;
  width: 112rpx;
  height: 88rpx;
  border-radius: 3rpx;
  opacity: 0;
  transform: translateY(22rpx) rotate(-5deg);
  animation: advanced-board-cycle 5.2s ease-in-out infinite;
}

.advanced-working-board-black { background: #191512; animation-delay: 0s; }
.advanced-working-board-red { background: #c93434; animation-delay: 1.3s; }
.advanced-working-board-yellow { background: #e7b82f; animation-delay: 2.6s; }
.advanced-working-board-green { background: #2f7a61; animation-delay: 3.9s; }

.advanced-working-avatar-wrap {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  width: 96rpx;
  height: 96rpx;
}

.advanced-working-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 3rpx solid #d7a53d;
}

.advanced-working-hand {
  position: absolute;
  right: -42rpx;
  top: 30rpx;
  width: 58rpx;
  height: 10rpx;
  background: #d7a53d;
  transform-origin: left center;
  animation: advanced-working-brush 0.8s ease-in-out infinite alternate;
}

.advanced-working-title,
.advanced-working-sub {
  display: block;
}

.advanced-working-title {
  color: #f2c94c;
  font-size: 24rpx;
  font-weight: 600;
}

.advanced-working-sub {
  margin-top: 8rpx;
  color: rgba(255, 247, 230, 0.55);
  font-size: 19rpx;
}

.advanced-working-progress {
  width: 100%;
  height: 5rpx;
  margin-top: 18rpx;
  overflow: hidden;
  background: rgba(255, 247, 230, 0.08);
}

.advanced-working-progress-fill {
  width: 42%;
  height: 100%;
  background: #c93434;
  animation: advanced-working-progress 1.8s ease-in-out infinite;
}

@keyframes advanced-board-cycle {
  0%, 8% { opacity: 0; transform: translateY(22rpx) rotate(-5deg); }
  18%, 42% { opacity: 1; transform: translateY(0) rotate(0); }
  50%, 100% { opacity: 0; transform: translateY(-14rpx) rotate(4deg); }
}

@keyframes advanced-working-brush {
  from { transform: rotate(-18deg) translateX(0); }
  to { transform: rotate(16deg) translateX(16rpx); }
}

@keyframes advanced-working-progress {
  from { transform: translateX(-110%); }
  to { transform: translateX(260%); }
}

/* 卷五木板2.5D放大展示 */
.advanced-board-preview-modal {
  position: fixed;
  inset: 0;
  z-index: 90;
  overflow: hidden;
  background: rgba(10, 6, 3, 0.96);
  perspective: 1400rpx;
}

.advanced-board-preview-close {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 24rpx);
  left: 28rpx;
  z-index: 5;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff7e6;
  font-size: 38rpx;
  background: rgba(255, 247, 230, 0.08);
  border: 1rpx solid rgba(255, 247, 230, 0.2);
  border-radius: 4rpx;
}

.advanced-board-preview-stage {
  position: absolute;
  inset: 120rpx 32rpx 150rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  perspective: 1200rpx;
  touch-action: none;
}

.advanced-board-preview-object {
  position: relative;
  width: 88vw;
  height: 68vh;
  transform-style: preserve-3d;
  transform-origin: center center;
}

.advanced-board-preview-layer {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.advanced-board-preview-back {
  opacity: 0.66;
  filter: brightness(0.38) sepia(0.48);
  transform: translateZ(-18rpx) translateX(10rpx);
}

.advanced-board-preview-mid {
  opacity: 0.8;
  filter: brightness(0.52) sepia(0.32);
  transform: translateZ(-9rpx) translateX(5rpx);
}

.advanced-board-preview-front {
  transform: translateZ(2rpx);
  backface-visibility: hidden;
}

.advanced-board-preview-name {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(env(safe-area-inset-bottom) + 62rpx);
  color: #f2c94c;
  font-size: 28rpx;
  text-align: center;
  font-family: "STXingkai", "华文行楷", "FZKai-Z03", "KaiTi", cursive;
}
