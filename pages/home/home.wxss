page {
  width: 100%;
  height: 100%;
  background: #0f0805;
  overflow: hidden;
}

.page-root {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  position: relative;
  background: #0f0805;
}

.global-bg-video {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
  object-fit: cover;
  pointer-events: none;
}

.global-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1;
  background: linear-gradient(180deg, rgba(15, 8, 5, 0.45) 0%, rgba(15, 8, 5, 0.6) 100%);
  pointer-events: none;
}

.main-swiper {
  position: relative;
  z-index: 2;
  width: 100vw;
  height: 100vh;
}

.screen {
  height: 100vh;
  width: 100vw;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  position: relative;
}

.music-btn {
  position: fixed;
  top: 72rpx;
  right: 32rpx;
  z-index: 20;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.music-icon {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.music-btn.spinning {
  animation: spin 4s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.nav-dots {
  position: fixed;
  right: 22rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 20;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.dot .dot-label {
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0);
  font-weight: 500;
  letter-spacing: 0;
  transition: color 0.35s ease;
}

.dot.active {
  width: 44rpx;
  background: #D42F2F;
  border-color: #D42F2F;
  box-shadow: 0 0 18rpx rgba(212, 47, 47, 0.55);
}

.dot.active .dot-label {
  color: #fff7e6;
  font-size: 20rpx;
}

.screen-label {
  font-size: 20rpx;
  letter-spacing: 0;
  color: rgba(255, 255, 255, 0.25);
  margin-bottom: 16rpx;
}

.screen-heading {
  font-size: 48rpx;
  font-weight: 200;
  color: #ffffff;
  letter-spacing: 0;
  margin-bottom: 40rpx;
}

.screen-1 {
  justify-content: center;
  align-items: center;
}

.s1-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.s1-line {
  width: 60rpx;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.2);
  margin-bottom: 40rpx;
}

.s1-subtitle {
  font-size: 24rpx;
  letter-spacing: 0;
  color: rgba(255, 255, 255, 0.4);
  text-transform: uppercase;
}

.s1-title {
  font-size: 80rpx;
  font-weight: 200;
  color: #ffffff;
  letter-spacing: 0;
  animation: fadeUp 1.5s ease-out 0.2s both;
}

.s1-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.45);
  letter-spacing: 0;
  margin-top: 16rpx;
  animation: fadeUp 1.5s ease-out 0.8s both;
}

.s1-bottom {
  position: absolute;
  bottom: 140rpx;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 36rpx;
}

.scroll-arrow {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.arrow-text {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.3);
  animation: float 2.5s ease-in-out infinite;
}

@keyframes float {
  0%,
  100% {
    transform: translateY(0);
    opacity: 0.3;
  }

  50% {
    transform: translateY(20rpx);
    opacity: 0.6;
  }
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.screen-2 {
  justify-content: center;
  padding: 0 64rpx;
}

.s2-header {
  margin-bottom: 64rpx;
}

.s2-label {
  font-size: 20rpx;
  letter-spacing: 0;
  color: rgba(255, 255, 255, 0.3);
}

.timeline {
  position: relative;
  padding-left: 48rpx;
}

.tl-line {
  position: absolute;
  left: 8rpx;
  top: 12rpx;
  bottom: 12rpx;
  width: 1rpx;
  background: rgba(255, 255, 255, 0.12);
}

.tl-node {
  position: relative;
  padding: 28rpx 0 28rpx 40rpx;
  transition: all 0.4s ease;
}

.tl-dot {
  position: absolute;
  left: -6rpx;
  top: 40rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  transition: all 0.4s ease;
}

.tl-active .tl-dot {
  background: #D42F2F;
  border-color: #D42F2F;
  box-shadow: 0 0 20rpx rgba(212, 47, 47, 0.4);
}

.dot-future {
  background: #F2C94C !important;
  border-color: #F2C94C !important;
}

.tl-active .dot-future {
  box-shadow: 0 0 20rpx rgba(242, 201, 76, 0.4) !important;
}

.tl-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tl-year {
  font-size: 52rpx;
  font-weight: 100;
  color: rgba(255, 255, 255, 0.15);
  letter-spacing: 0;
  line-height: 1;
  transition: all 0.4s ease;
}

.tl-active .tl-year {
  color: rgba(255, 255, 255, 0.6);
}

.tl-era-name {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 500;
  letter-spacing: 0;
}

.tl-one-line {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
  letter-spacing: 0;
}

/* ═══════════════════════════════
   屏4 · 五色套印 · 纸拖印刷游戏
   ═══════════════════════════════ */

.screen-color-game {
  justify-content: flex-start;
  align-items: center;
  padding: 56rpx 48rpx 32rpx;
  box-sizing: border-box;
}

.color-game-header {
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.color-game-header .screen-label {
  margin-bottom: 8rpx;
}

.color-game-header .screen-heading {
  flex: 1;
  margin-bottom: 8rpx;
  padding-left: 16rpx;
}

.reset-hidden {
  opacity: 0;
  pointer-events: none;
}

/* ── 木板切换指示器 ── */
.block-indicator {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 12rpx;
  padding: 12rpx 0;
}

.block-arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.block-arrow:active {
  background: rgba(255, 255, 255, 0.14);
}

.block-arrow-text {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1;
  margin-top: -4rpx;
}

.arrow-dim {
  opacity: 0.25;
  pointer-events: none;
}

.block-current {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.03);
  transition: all 0.2s;
}

.block-current:active {
  background: rgba(255, 255, 255, 0.08);
}

.block-dot-main {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
}

.block-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.block-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.block-hint {
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.35);
  letter-spacing: 1rpx;
}

/* ── 纸拖印刷区域 ── */
.paper-drag-area {
  width: 100%;
  height: 440rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 版台 */
.woodbed {
  position: absolute;
  bottom: 24rpx;
  left: 26rpx;
  right: 26rpx;
  height: 86rpx;
  background: linear-gradient(180deg, #6B3A20 0%, #4A2210 100%);
  border-radius: 0 0 16rpx 16rpx;
  border: 1rpx solid rgba(255, 235, 206, 0.1);
  border-top: 4rpx solid #8B5A2B;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 16rpx 40rpx rgba(0, 0, 0, 0.45),
    inset 0 4rpx 0 rgba(255, 255, 255, 0.04);
  transition: border-top-color 0.24s ease, box-shadow 0.24s ease;
}

.woodbed-grain {
  position: absolute;
  inset: 0;
  background:
    repeating-linear-gradient(
      90deg,
      transparent,
      transparent 6rpx,
      rgba(0, 0, 0, 0.06) 6rpx,
      rgba(0, 0, 0, 0.06) 8rpx
    ),
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.03) 0%,
      transparent 40%,
      rgba(0, 0, 0, 0.08) 100%
    );
  pointer-events: none;
}

.woodbed-label {
  position: relative;
  z-index: 1;
}

.woodbed-label-text {
  font-size: 22rpx;
  color: rgba(255, 235, 206, 0.35);
  letter-spacing: 4rpx;
}

/* 纸张 */
.paper-sheet {
  width: 400rpx;
  height: 310rpx;
  position: absolute;
  top: 20rpx;
  left: 50%;
  margin-left: -200rpx;
  border-radius: 8rpx;
  background: #F3E4C4;
  border: 1rpx solid rgba(77, 35, 13, 0.4);
  box-shadow:
    inset 0 0 0 10rpx rgba(255, 255, 255, 0.25),
    inset 0 0 40rpx rgba(80, 35, 10, 0.18),
    0 28rpx 64rpx rgba(0, 0, 0, 0.4);
  overflow: hidden;
  z-index: 5;
  transition: transform 0.28s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  transform-origin: 50% 80%;
}

.paper-texture {
  position: absolute;
  inset: 0;
  z-index: 20;
  background:
    linear-gradient(90deg, rgba(80, 35, 10, 0.03) 0, transparent 24%, rgba(255, 255, 255, 0.06) 48%, transparent 76%, rgba(80, 35, 10, 0.04) 100%);
  pointer-events: none;
}

.paper-dragging {
  transition: none;
}

.paper-pressing {
  transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow:
    inset 0 0 0 10rpx rgba(255, 255, 255, 0.2),
    inset 0 0 30rpx rgba(80, 35, 10, 0.2),
    0 6rpx 20rpx rgba(0, 0, 0, 0.3);
}

/* 纸上图层 */
.paper-layer {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 320rpx;
  height: 245rpx;
  opacity: 0;
  transform: translate(-50%, -50%) scale(1.1);
  transition: opacity 0.32s ease, transform 0.38s ease;
  mix-blend-mode: multiply;
}

.layer-visible {
  opacity: 0.94;
  transform: translate(-50%, -50%) scale(1);
}

.layer-fresh {
  animation: none;
  transition: none;
}

@keyframes inkSettlePaper {
  0% {
    opacity: 0;
    transform: translate(-50%, -60%) scale(1.1);
    filter: blur(2rpx) contrast(1.2);
  }
  55% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(0.98);
    filter: blur(0) contrast(1.1);
  }
  100% {
    opacity: 0.94;
    transform: translate(-50%, -50%) scale(1);
    filter: blur(0) contrast(1.05);
  }
}

/* 纸张空态提示 */
.paper-empty-hint {
  position: absolute;
  inset: 0;
  z-index: 30;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.hint-arrow {
  font-size: 52rpx;
  color: rgba(90, 40, 15, 0.3);
  animation: hintBounce 1.8s ease-in-out infinite;
}

@keyframes hintBounce {
  0%, 100% {
    transform: translateY(0);
    opacity: 0.3;
  }
  50% {
    transform: translateY(16rpx);
    opacity: 0.6;
  }
}

.hint-text {
  font-size: 24rpx;
  color: rgba(80, 35, 10, 0.45);
  letter-spacing: 2rpx;
  font-weight: 500;
}

.hint-sub {
  font-size: 20rpx;
  color: rgba(80, 35, 10, 0.3);
  letter-spacing: 1rpx;
}

/* ── 色版选择器 ── */
.block-selector {
  width: 100%;
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
  margin: 8rpx 0 16rpx;
  position: relative;
}

.block-selector::before {
  content: "";
  position: absolute;
  left: 42rpx;
  right: 42rpx;
  top: 32rpx;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.1);
}

.block-chip {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 6rpx 4rpx;
  position: relative;
  z-index: 1;
  border-radius: 12rpx;
  border: 1rpx solid transparent;
  transition: all 0.25s ease;
  min-width: 100rpx;
}

.block-chip:active {
  background: rgba(255, 255, 255, 0.05);
}

.chip-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  opacity: 0.55;
  transform: scale(0.9);
  transition: all 0.25s ease;
  font-size: 24rpx;
  font-weight: 600;
}

.chip-name {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  letter-spacing: 1rpx;
}

.chip-check {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 700;
}

.chip-printed .chip-dot {
  opacity: 0.95;
  transform: scale(1);
}

.chip-printed .chip-name {
  color: rgba(255, 255, 255, 0.65);
}

.chip-active .chip-dot {
  opacity: 1;
  transform: scale(1.12);
  box-shadow: 0 0 24rpx rgba(255, 255, 255, 0.2);
}

.chip-active .chip-name {
  color: #ffffff;
  font-weight: 500;
}

.chip-active {
  border-color: rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.04);
}

/* ── 颜色信息面板（保留复用） ── */
.color-info {
  min-height: 152rpx;
  background: rgba(15, 8, 4, 0.48);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  padding: 20rpx 28rpx;
  width: 100%;
  box-sizing: border-box;
  transition: border-color 0.24s ease, background 0.24s ease;
}

.color-info-live {
  background: rgba(34, 14, 5, 0.58);
  border-color: rgba(242, 201, 76, 0.18);
}

.color-info-kicker {
  font-size: 20rpx;
  color: rgba(242, 201, 76, 0.62);
  display: block;
  margin-bottom: 6rpx;
}

.color-info-name {
  font-size: 30rpx;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.color-info-line {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.48);
  display: block;
  line-height: 1.5;
}

.color-info-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  display: block;
  margin-top: 8rpx;
  line-height: 1.5;
}

/* ── 高级版台：实际分色木板交互 ── */
.screen-advanced-print {
  justify-content: flex-start;
  padding: 76rpx 42rpx 34rpx;
  box-sizing: border-box;
}

.advanced-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.advanced-header .screen-heading {
  margin-bottom: 0;
}

.advanced-stage {
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  align-items: stretch;
  perspective: 900rpx;
}

.advanced-board-card,
.advanced-proof-card {
  min-height: 430rpx;
  border-radius: 12rpx;
  background: rgba(15, 8, 5, 0.68);
  border: 1rpx solid rgba(230, 168, 23, 0.12);
  position: relative;
}

.advanced-card-head {
  height: 94rpx;
  padding: 12rpx 18rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.03);
}

.advanced-title-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  align-items: center;
}

.advanced-board-title {
  max-width: 100%;
  font-size: 25rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.advanced-board-sub {
  max-width: 100%;
  font-size: 18rpx;
  color: rgba(255, 247, 230, 0.4);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.advanced-board-slot {
  height: 336rpx;
  margin: 0 14rpx 14rpx;
  border-radius: 8rpx;
  border: 1rpx dashed rgba(230, 168, 23, 0.22);
  background:
    linear-gradient(120deg, rgba(255, 247, 230, 0.05), transparent 42%),
    #1b1009;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.advanced-slot-filled {
  border-style: solid;
  background: #1b1009;
}

.advanced-board-img {
  width: 100%;
  height: 100%;
  transform-origin: center center;
  transition: transform 0.24s ease, opacity 0.24s ease;
}

.advanced-board-moving {
  animation: advancedBoardMoveIn 0.36s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes advancedBoardMoveIn {
  0% {
    opacity: 0.45;
    transform: translateY(146rpx) scale(0.45);
  }
  68% {
    opacity: 1;
    transform: translateY(-8rpx) scale(1.04);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.advanced-slot-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  color: rgba(255, 247, 230, 0.28);
}

.advanced-slot-empty-mark {
  width: 74rpx;
  height: 74rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(230, 168, 23, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.advanced-slot-empty-mark-text {
  font-size: 32rpx;
  color: rgba(230, 168, 23, 0.52);
}

.advanced-slot-empty-text {
  font-size: 21rpx;
  letter-spacing: 2rpx;
}

.advanced-proof-head {
  height: 72rpx;
  padding: 14rpx 18rpx 10rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.advanced-proof-title {
  font-size: 24rpx;
  color: #fff7e6;
  font-weight: 500;
}

.advanced-proof-count {
  font-size: 20rpx;
  color: rgba(242, 201, 76, 0.68);
  font-family: 'Courier New', monospace;
}

.advanced-proof-paper {
  height: 358rpx;
  margin: 0 14rpx 14rpx;
  position: relative;
  border-radius: 8rpx;
  background:
    linear-gradient(90deg, rgba(80, 35, 10, 0.04), transparent 28%, rgba(255, 255, 255, 0.08) 50%, transparent 72%, rgba(80, 35, 10, 0.04)),
    #F3E4C4;
  border: 1rpx solid rgba(77, 35, 13, 0.25);
  overflow: hidden;
  transform-origin: left center;
  transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  will-change: transform;
  z-index: 3;
  backface-visibility: visible;
  transform-style: preserve-3d;
}

.advanced-paper-armed {
  border-color: rgba(230, 168, 23, 0.62);
  box-shadow: 0 14rpx 34rpx rgba(0, 0, 0, 0.26);
}

.advanced-paper-dragging {
  transition: none;
}

.advanced-paper-snap {
  box-shadow: 0 18rpx 40rpx rgba(212, 47, 47, 0.18);
}

.advanced-paper-back {
  position: absolute;
  inset: 0;
  z-index: 14;
  opacity: 0;
  pointer-events: none;
  background:
    linear-gradient(90deg, rgba(100, 52, 18, 0.08), transparent 28%, rgba(255, 255, 255, 0.22) 48%, transparent 70%, rgba(100, 52, 18, 0.08)),
    #E9D8B8;
  transition: opacity 0.12s ease;
}

.advanced-paper-back-fiber {
  position: absolute;
  inset: 0;
  background:
    repeating-linear-gradient(
      0deg,
      rgba(112, 77, 42, 0.06),
      rgba(112, 77, 42, 0.06) 1rpx,
      transparent 1rpx,
      transparent 7rpx
    ),
    repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.08),
      rgba(255, 255, 255, 0.08) 1rpx,
      transparent 1rpx,
      transparent 11rpx
    );
}

.advanced-paper-back-visible .advanced-paper-back {
  opacity: 1;
}

.advanced-paper-back-visible .advanced-proof-layer,
.advanced-paper-back-visible .advanced-proof-empty {
  opacity: 0;
}

.advanced-proof-layer {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 0.24s ease, transform 0.24s ease;
  transform: scale(1.02);
  mix-blend-mode: multiply;
}

.advanced-layer-visible {
  opacity: 0.94;
  transform: scale(1);
}

.advanced-proof-empty {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
