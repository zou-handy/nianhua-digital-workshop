   ═════════════════════════════════════════════ */
.chapter-indicator {
  position: fixed;
  top: 72rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 22rpx 8rpx 16rpx;
  background: rgba(15, 8, 5, 0.55);
  border: 1rpx solid rgba(230, 168, 23, 0.18);
  border-radius: 4rpx;
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.45);
  animation: chapterFadeIn 0.5s ease;
}

@keyframes chapterFadeIn {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(-12rpx);
  }
  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
}

.chapter-volume {
  font-size: 18rpx;
  color: rgba(230, 168, 23, 0.75);
  letter-spacing: 4rpx;
  font-weight: 500;
}

.chapter-seal {
  width: 36rpx;
  height: 36rpx;
  background: #D42F2F;
  border-radius: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    inset 0 0 0 2rpx rgba(255, 245, 230, 0.25),
    0 2rpx 6rpx rgba(196, 30, 58, 0.4);
}

.chapter-seal-char {
  font-size: 22rpx;
  color: #fff7e6;
  font-weight: 700;
  line-height: 1;
}

.chapter-name {
  font-size: 20rpx;
  color: rgba(255, 247, 230, 0.85);
  letter-spacing: 4rpx;
  font-weight: 500;
}

.s1-subtitle-cn {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 247, 230, 0.55);
  margin-top: -8rpx;
  animation: fadeUp 1.4s ease-out 0.5s both;
}

/* ── 封面 · 套印揭幕 ── */
.screen-1 {
  justify-content: flex-start;
  align-items: center;
  padding: 126rpx 42rpx 118rpx;
  overflow: hidden;
  background:
    linear-gradient(180deg, rgba(12, 6, 3, 0.18) 0%, rgba(12, 6, 3, 0.72) 100%),
    #0f0805;
}

.s1-woodgrain,
.s1-red-wash {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.s1-woodgrain {
  z-index: 0;
  opacity: 0.28;
  background:
    repeating-linear-gradient(
      92deg,
      rgba(255, 247, 230, 0.04),
      rgba(255, 247, 230, 0.04) 1rpx,
      transparent 1rpx,
      transparent 18rpx
    ),
    repeating-linear-gradient(
      0deg,
      rgba(80, 35, 10, 0.14),
      rgba(80, 35, 10, 0.14) 2rpx,
      transparent 2rpx,
      transparent 32rpx
    );
}

.s1-red-wash {
  z-index: 0;
  opacity: 0.72;
  background:
    linear-gradient(135deg, rgba(196, 30, 58, 0.2) 0%, rgba(196, 30, 58, 0.04) 36%, transparent 62%),
    linear-gradient(315deg, rgba(45, 93, 161, 0.14) 0%, transparent 44%);
}

.s1-print-stage {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 640rpx;
  height: 548rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  animation: s1StageIn 0.52s ease-out both;
}

.s1-print-stage:active {
  transform: scale(0.99);
}

.s1-print-inner {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.s1-board-back {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  top: 46rpx;
  height: 380rpx;
  border-radius: 8rpx;
  background:
    repeating-linear-gradient(
      90deg,
      rgba(255, 247, 230, 0.06),
      rgba(255, 247, 230, 0.06) 2rpx,
      transparent 2rpx,
      transparent 22rpx
    ),
    linear-gradient(180deg, #6B3A20 0%, #331609 100%);
  border: 1rpx solid rgba(230, 168, 23, 0.18);
  box-shadow:
    inset 0 12rpx 24rpx rgba(255, 247, 230, 0.05),
    0 28rpx 70rpx rgba(0, 0, 0, 0.46);
  transform: rotate(-3deg);
}

.s1-paper {
  position: relative;
  width: 500rpx;
  height: 392rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background:
    linear-gradient(90deg, rgba(80, 35, 10, 0.05), transparent 28%, rgba(255, 255, 255, 0.18) 50%, transparent 72%, rgba(80, 35, 10, 0.06)),
    #F3E4C4;
  border: 1rpx solid rgba(77, 35, 13, 0.36);
  box-shadow:
    inset 0 0 0 12rpx rgba(255, 255, 255, 0.16),
    inset 0 0 54rpx rgba(80, 35, 10, 0.14),
    0 24rpx 64rpx rgba(0, 0, 0, 0.48);
  transform-origin: 50% 82%;
  animation: s1PaperPress 2.42s cubic-bezier(0.16, 1, 0.3, 1) 0.18s both;
}

.s1-paper-fiber {
  position: absolute;
  inset: 0;
  z-index: 8;
  pointer-events: none;
  background:
    repeating-linear-gradient(
      0deg,
      rgba(112, 77, 42, 0.055),
      rgba(112, 77, 42, 0.055) 1rpx,
      transparent 1rpx,
      transparent 9rpx
    ),
    repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.08),
      rgba(255, 255, 255, 0.08) 1rpx,
      transparent 1rpx,
      transparent 15rpx
    );
}

.s1-print-layer {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 444rpx;
  height: 344rpx;
  opacity: 0;
  transform: translate(-50%, -58%) scale(1.08);
  mix-blend-mode: multiply;
}

.s1-print-running .s1-print-layer {
  animation: s1LayerPrint 0.72s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.s1-ink-sweep {
  position: absolute;
  left: -24%;
  top: 16%;
  z-index: 9;
  width: 46%;
  height: 70%;
  pointer-events: none;
  opacity: 0;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 247, 230, 0.28) 48%, transparent 100%);
  transform: skewX(-18deg);
}

.s1-print-running .s1-ink-sweep {
  animation: s1InkSweep 1.72s ease-out 0.36s both;
}

.s1-print-seal {
  position: absolute;
  right: 28rpx;
  bottom: 26rpx;
  z-index: 12;
  width: 62rpx;
  height: 62rpx;
  border-radius: 4rpx;
  background: rgba(196, 30, 58, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    inset 0 0 0 3rpx rgba(255, 247, 230, 0.18),
    0 8rpx 20rpx rgba(196, 30, 58, 0.3);
  opacity: 0;
  transform: scale(1.26) rotate(-8deg);
  animation: s1SealDrop 0.42s cubic-bezier(0.34, 1.56, 0.64, 1) 2.08s both;
}

.s1-print-seal-text {
  font-size: 34rpx;
  color: #fff7e6;
  font-weight: 700;
  line-height: 1;
}

.s1-process-row {
  width: 500rpx;
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
}

.s1-process-step {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  opacity: 0;
  transform: translateY(12rpx);
  animation: s1ProcessIn 0.36s ease-out both;
}

.s1-process-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 247, 230, 0.22);
  flex-shrink: 0;
}

.s1-process-name {
  max-width: 86rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 19rpx;
  color: rgba(255, 247, 230, 0.56);
  letter-spacing: 1rpx;
}

.s1-content {
  position: relative;
  z-index: 3;
  width: 100%;
  max-width: 660rpx;
  gap: 14rpx;
  margin-top: -8rpx;
  text-align: center;
}

.s1-seal {
  margin-bottom: 12rpx;
  padding: 8rpx 18rpx;
  border-radius: 4rpx;
  color: #fff7e6;
  background: rgba(196, 30, 58, 0.72);
  border: 1rpx solid rgba(255, 247, 230, 0.22);
  box-shadow: 0 8rpx 26rpx rgba(196, 30, 58, 0.24);
  animation: fadeUp 0.62s ease-out 1.78s both;
}

.s1-line {
  width: 86rpx;
  margin-bottom: 14rpx;
  background: linear-gradient(90deg, transparent, rgba(230, 168, 23, 0.78), transparent);
}

.s1-subtitle {
  font-size: 21rpx;
  color: rgba(255, 247, 230, 0.42);
  animation: fadeUp 0.62s ease-out 1.92s both;
}

.s1-subtitle-cn {
  margin-top: -4rpx;
  font-size: 21rpx;
  color: rgba(255, 247, 230, 0.58);
  animation: fadeUp 0.62s ease-out 2.02s both;
}

.s1-title {
  font-size: 76rpx;
  font-weight: 500;
  color: #fff7e6;
  text-shadow:
    0 2rpx 0 rgba(77, 35, 13, 0.7),
    0 18rpx 44rpx rgba(0, 0, 0, 0.48);
  animation: fadeUp 0.7s ease-out 2.12s both;
}

.s1-desc {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: rgba(255, 247, 230, 0.62);
  animation: fadeUp 0.7s ease-out 2.24s both;
}

.s1-wood-bar {
  width: 148rpx;
  height: 3rpx;
  margin-top: 16rpx;
  background: linear-gradient(90deg, transparent, #E6A817 20%, #D42F2F 50%, #5396AC 80%, transparent);
  animation: fadeUp 0.7s ease-out 2.36s both;
}

.s1-bottom {
  z-index: 4;
  bottom: 72rpx;
}

.arrow-text {
  color: rgba(255, 247, 230, 0.38);
}

.arrow-hint {
  color: rgba(255, 247, 230, 0.32);
}

@keyframes s1StageIn {
  from {
    opacity: 0;
    transform: translateY(24rpx) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes s1PaperPress {
  0% {
    transform: translateY(-18rpx) rotate(-2deg) scale(0.98);
  }
  16% {
    transform: translateY(0) rotate(0deg) scale(1.01);
  }
  30%,
  68% {
    transform: translateY(0) rotate(0deg) scale(1);
  }
  78% {
    transform: translateY(6rpx) rotate(0deg) scale(0.992);
  }
  100% {
    transform: translateY(0) rotate(0deg) scale(1);
  }
}

@keyframes s1LayerPrint {
  0% {
    opacity: 0;
    transform: translate(-50%, -62%) scale(1.12);
  }
  58% {
    opacity: 0.98;
    transform: translate(-50%, -50%) scale(0.985);
  }
  100% {
    opacity: 0.96;
    transform: translate(-50%, -50%) scale(1);
  }
}

@keyframes s1InkSweep {
  0% {
    opacity: 0;
    transform: translateX(0) skewX(-18deg);
  }
  18% {
    opacity: 0.65;
  }
  100% {
    opacity: 0;
    transform: translateX(720rpx) skewX(-18deg);
  }
}

@keyframes s1SealDrop {
  0% {
    opacity: 0;
    transform: scale(1.26) rotate(-8deg);
  }
  72% {
    opacity: 1;
    transform: scale(0.94) rotate(-3deg);
  }
  100% {
    opacity: 1;
    transform: scale(1) rotate(-3deg);
  }
}

@keyframes s1ProcessIn {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ═════════════════════════════════════════════
   屏 · 刀具图鉴
   ═════════════════════════════════════════════ */
.screen-tools {
  justify-content: flex-start;
  padding: 120rpx 48rpx 40rpx;
  box-sizing: border-box;
}

.tools-header {
  margin-bottom: 24rpx;
}

.tools-hint {
  font-size: 22rpx;
  color: rgba(230, 168, 23, 0.55);
  letter-spacing: 2rpx;
  display: block;
  margin-top: 8rpx;
}

/* 签条墙 */
.tools-wall {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx 20rpx;
  padding: 24rpx 0 28rpx;
}

.tool-tag {
  position: relative;
  height: 188rpx;
  padding: 28rpx 14rpx 18rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #F3E4C4 0%, #E5D2A8 100%);
  border-radius: 4rpx 4rpx 8rpx 8rpx;
  border: 1rpx solid rgba(77, 35, 13, 0.25);
  box-shadow:
    inset 0 -10rpx 20rpx rgba(80, 35, 10, 0.08),
    0 6rpx 16rpx rgba(0, 0, 0, 0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 6rpx;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  transform: rotate(-1deg);
}

.tool-tag:nth-child(2n) { transform: rotate(1.2deg); }
.tool-tag:nth-child(3n) { transform: rotate(-0.8deg); }

.tool-tag:active {
  transform: scale(0.96) rotate(0deg);
}

.tool-tag-string {
  position: absolute;
  top: -14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 1rpx;
  height: 18rpx;
  background: rgba(255, 247, 230, 0.3);
}

.tool-tag-hole {
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 14rpx;
  height: 14rpx;
  background: rgba(15, 8, 5, 0.7);
  border-radius: 50%;
  box-shadow:
    inset 0 1rpx 2rpx rgba(0, 0, 0, 0.6),
    0 1rpx 0 rgba(255, 247, 230, 0.3);
}

.tool-tag-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  width: 100%;
  margin-top: 16rpx;
}

.tool-tag-num {
  font-size: 18rpx;
  color: rgba(77, 35, 13, 0.45);
  letter-spacing: 2rpx;
  font-weight: 500;
}

.tool-tag-name {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--tool-color);
  letter-spacing: 0;
  line-height: 1.05;
  margin-top: 2rpx;
  text-shadow: 0 1rpx 0 rgba(255, 247, 230, 0.5);
}

.tool-tag-bar {
  width: 28rpx;
  height: 2rpx;
  background: var(--tool-color);
  opacity: 0.6;
  margin: 4rpx 0;
}

.tool-tag-purpose {
  font-size: 18rpx;
  color: rgba(77, 35, 13, 0.7);
  letter-spacing: 1rpx;
  text-align: center;
}

.tool-tag.tool-active {
  transform: rotate(0deg) scale(1.05) translateY(-6rpx);
  box-shadow:
    inset 0 -10rpx 20rpx rgba(80, 35, 10, 0.08),
    0 14rpx 32rpx rgba(0, 0, 0, 0.5),
    0 0 0 2rpx var(--tool-color);
}

.tool-tag.tool-active::after {
  content: "";
  position: absolute;
  inset: 4rpx;
  border: 1rpx dashed var(--tool-color);
  border-radius: 2rpx;
  opacity: 0.4;
  pointer-events: none;
}

/* 详情卡片 */
.tool-detail-card {
  margin-top: 8rpx;
  padding: 24rpx 24rpx 20rpx;
  background: rgba(15, 8, 5, 0.7);
  border: 1rpx solid rgba(230, 168, 23, 0.18);
  border-radius: 12rpx;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  transition: border-color 0.4s ease;
}

.tool-detail-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 16rpx;
}

.tool-detail-image {
  display: block;
  width: 260rpx;
  height: 340rpx;
  border-radius: 8rpx;
  margin: 0 auto 16rpx;
  background: rgba(243, 228, 196, 0.08);
  border: 1rpx solid rgba(230, 168, 23, 0.12);
}

.tool-detail-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow:
    inset 0 0 0 2rpx rgba(255, 247, 230, 0.3),
    0 4rpx 12rpx rgba(0, 0, 0, 0.4);
}

.tool-detail-icon-text {
  font-size: 36rpx;
  color: #fff7e6;
  font-weight: 700;
}

.tool-detail-title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.tool-detail-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff7e6;
  letter-spacing: 3rpx;
}

.tool-detail-purpose {
  font-size: 20rpx;
  color: rgba(230, 168, 23, 0.7);
  letter-spacing: 2rpx;
}

.tool-detail-spec {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2rpx;
}

.tool-spec-line {
  font-size: 18rpx;
  color: rgba(255, 247, 230, 0.55);
  letter-spacing: 1rpx;
  font-family: 'Courier New', monospace;
}

.tool-spec-weight {
  color: rgba(255, 247, 230, 0.35);
}

.tool-detail-desc {
  font-size: 22rpx;
  color: rgba(255, 247, 230, 0.7);
  line-height: 1.65;
  display: block;
  margin-bottom: 14rpx;
}

.tool-detail-tip {
  padding: 12rpx 16rpx;
  background: rgba(196, 30, 58, 0.08);
  border-left: 2rpx solid rgba(196, 30, 58, 0.4);
  border-radius: 0 6rpx 6rpx 0;
  margin-bottom: 14rpx;
}

.tool-tip-label {
  font-size: 16rpx;
  color: rgba(196, 30, 58, 0.7);
  letter-spacing: 3rpx;
  display: block;
  margin-bottom: 4rpx;
}

.tool-tip-text {
  font-size: 20rpx;
  color: rgba(255, 247, 230, 0.55);
  line-height: 1.55;
}

.tool-detail-more {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  padding: 6rpx 4rpx 2rpx;
}

.tool-detail-more-label {
  font-size: 20rpx;
  color: rgba(230, 168, 23, 0.7);
  letter-spacing: 3rpx;
}

.tool-detail-more .more-arrow {
  font-size: 22rpx;
  color: #E6A817;
}

/* 工具大图弹窗 */
.tool-modal {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.85);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  animation: fadeIn 0.3s ease;
}

.tool-modal-content {
