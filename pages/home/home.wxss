/* ═══════════════════════════════
   屏4 · 五色套印 · 纸拖印刷游戏
   ═══════════════════════════════ */

.screen-color-game {
  justify-content: flex-start;
  align-items: center;
  padding: 56rpx 48rpx 32rpx;
  box-sizing: border-box;
}

.color-game-header {
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.color-game-header .screen-label {
  margin-bottom: 8rpx;
}

.color-game-header .screen-heading {
  flex: 1;
  margin-bottom: 8rpx;
  padding-left: 16rpx;
}

.reset-hidden {
  opacity: 0;
  pointer-events: none;
}

/* ── 木板切换指示器 ── */
.block-indicator {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 12rpx;
  padding: 12rpx 0;
}

.block-arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.block-arrow:active {
  background: rgba(255, 255, 255, 0.14);
}

.block-arrow-text {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1;
  margin-top: -4rpx;
}

.arrow-dim {
  opacity: 0.25;
  pointer-events: none;
}

.block-current {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.03);
  transition: all 0.2s;
}

.block-current:active {
  background: rgba(255, 255, 255, 0.08);
}

.block-dot-main {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
}

.block-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.block-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.block-hint {
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.35);
  letter-spacing: 1rpx;
}

/* ── 纸拖印刷区域 ── */
.paper-drag-area {
  width: 100%;
  height: 440rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 版台 */
.woodbed {
  position: absolute;
  bottom: 24rpx;
  left: 26rpx;
  right: 26rpx;
  height: 86rpx;
  background: linear-gradient(180deg, #6B3A20 0%, #4A2210 100%);
  border-radius: 0 0 16rpx 16rpx;
  border: 1rpx solid rgba(255, 235, 206, 0.1);
  border-top: 4rpx solid #8B5A2B;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 16rpx 40rpx rgba(0, 0, 0, 0.45),
    inset 0 4rpx 0 rgba(255, 255, 255, 0.04);
  transition: border-top-color 0.24s ease, box-shadow 0.24s ease;
}

.woodbed-grain {
  position: absolute;
  inset: 0;
  background:
    repeating-linear-gradient(
      90deg,
      transparent,
      transparent 6rpx,
      rgba(0, 0, 0, 0.06) 6rpx,
      rgba(0, 0, 0, 0.06) 8rpx
    ),
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.03) 0%,
      transparent 40%,
      rgba(0, 0, 0, 0.08) 100%
    );
  pointer-events: none;
}

.woodbed-label {
  position: relative;
  z-index: 1;
}

.woodbed-label-text {
  font-size: 22rpx;
  color: rgba(255, 235, 206, 0.35);
  letter-spacing: 4rpx;
}

/* 纸张 */
.paper-sheet {
  width: 400rpx;
  height: 310rpx;
  position: absolute;
  top: 20rpx;
  left: 50%;
  margin-left: -200rpx;
  border-radius: 8rpx;
  background: #F3E4C4;
  border: 1rpx solid rgba(77, 35, 13, 0.4);
  box-shadow:
    inset 0 0 0 10rpx rgba(255, 255, 255, 0.25),
    inset 0 0 40rpx rgba(80, 35, 10, 0.18),
    0 28rpx 64rpx rgba(0, 0, 0, 0.4);
  overflow: hidden;
  z-index: 5;
  transition: transform 0.28s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  transform-origin: 50% 80%;
}

.paper-texture {
  position: absolute;
  inset: 0;
  z-index: 20;
  background:
    linear-gradient(90deg, rgba(80, 35, 10, 0.03) 0, transparent 24%, rgba(255, 255, 255, 0.06) 48%, transparent 76%, rgba(80, 35, 10, 0.04) 100%);
  pointer-events: none;
}

.paper-dragging {
  transition: none;
}

.paper-pressing {
  transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow:
    inset 0 0 0 10rpx rgba(255, 255, 255, 0.2),
    inset 0 0 30rpx rgba(80, 35, 10, 0.2),
    0 6rpx 20rpx rgba(0, 0, 0, 0.3);
}

/* 纸上图层 */
.paper-layer {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 320rpx;
  height: 245rpx;
  opacity: 0;
  transform: translate(-50%, -50%) scale(1.1);
  transition: opacity 0.32s ease, transform 0.38s ease;
  mix-blend-mode: multiply;
}

.layer-visible {
  opacity: 0.94;
  transform: translate(-50%, -50%) scale(1);
}

.layer-fresh {
  animation: none;
  transition: none;
}

@keyframes inkSettlePaper {
  0% {
    opacity: 0;
    transform: translate(-50%, -60%) scale(1.1);
    filter: blur(2rpx) contrast(1.2);
  }
  55% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(0.98);
    filter: blur(0) contrast(1.1);
  }
  100% {
    opacity: 0.94;
    transform: translate(-50%, -50%) scale(1);
    filter: blur(0) contrast(1.05);
  }
}

/* 纸张空态提示 */
.paper-empty-hint {
  position: absolute;
  inset: 0;
  z-index: 30;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.hint-arrow {
  font-size: 52rpx;
  color: rgba(90, 40, 15, 0.3);
  animation: hintBounce 1.8s ease-in-out infinite;
}

@keyframes hintBounce {
  0%, 100% {
    transform: translateY(0);
    opacity: 0.3;
  }
  50% {
    transform: translateY(16rpx);
    opacity: 0.6;
  }
}

.hint-text {
  font-size: 24rpx;
  color: rgba(80, 35, 10, 0.45);
  letter-spacing: 2rpx;
  font-weight: 500;
}

.hint-sub {
  font-size: 20rpx;
  color: rgba(80, 35, 10, 0.3);
  letter-spacing: 1rpx;
}

/* ── 色版选择器 ── */
.block-selector {
  width: 100%;
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
  margin: 8rpx 0 16rpx;
  position: relative;
}

.block-selector::before {
  content: "";
  position: absolute;
  left: 42rpx;
  right: 42rpx;
  top: 32rpx;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.1);
}

.block-chip {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 6rpx 4rpx;
  position: relative;
  z-index: 1;
  border-radius: 12rpx;
  border: 1rpx solid transparent;
  transition: all 0.25s ease;
  min-width: 100rpx;
}

.block-chip:active {
  background: rgba(255, 255, 255, 0.05);
}

.chip-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  opacity: 0.55;
  transform: scale(0.9);
  transition: all 0.25s ease;
  font-size: 24rpx;
  font-weight: 600;
}

.chip-name {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  letter-spacing: 1rpx;
}

.chip-check {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 700;
}

.chip-printed .chip-dot {
  opacity: 0.95;
  transform: scale(1);
}

.chip-printed .chip-name {
  color: rgba(255, 255, 255, 0.65);
}

.chip-active .chip-dot {
  opacity: 1;
  transform: scale(1.12);
  box-shadow: 0 0 24rpx rgba(255, 255, 255, 0.2);
}

.chip-active .chip-name {
  color: #ffffff;
  font-weight: 500;
}

.chip-active {
  border-color: rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.04);
}

/* ── 颜色信息面板（保留复用） ── */
.color-info {
  min-height: 152rpx;
