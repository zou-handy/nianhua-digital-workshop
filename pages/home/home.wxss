/* ── 高级版台：实际分色木板交互 ── */
.screen-advanced-print {
  justify-content: flex-start;
  padding: 76rpx 42rpx 34rpx;
  box-sizing: border-box;
  overflow-y: auto;
  padding-bottom: 120rpx;
}

.advanced-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.advanced-work-switch {
  width: 100%;
  margin: 14rpx 0 12rpx;
  display: flex;
  padding: 4rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(215, 165, 61, 0.28);
  background: rgba(15, 8, 5, 0.68);
}

.advanced-work-option {
  flex: 1;
  min-width: 92rpx;
  height: 48rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 247, 230, 0.52);
  font-size: 18rpx;
}

.advanced-work-option-active {
  color: #fff7e6;
  background: #8f2634;
}

.advanced-source-strip {
  width: 100%;
  min-height: 104rpx;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  border-top: 1rpx solid rgba(215, 165, 61, 0.2);
  border-bottom: 1rpx solid rgba(215, 165, 61, 0.2);
  background: rgba(15, 8, 5, 0.46);
}

.advanced-source-image {
  width: 126rpx;
  height: 94rpx;
  flex: 0 0 126rpx;
  background: rgba(243, 228, 196, 0.06);
}

.advanced-source-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.advanced-source-label {
  color: rgba(215, 165, 61, 0.68);
  font-size: 16rpx;
}

.advanced-source-name {
  color: #fff7e6;
  font-size: 21rpx;
}

.advanced-source-count {
  padding-right: 14rpx;
  color: rgba(255, 247, 230, 0.48);
  font-size: 18rpx;
}

.advanced-header .screen-heading {
  margin-bottom: 0;
}

.advanced-stage {
  width: 100%;
  display: grid;
  grid-template-columns: 0.86fr 1.14fr;
  gap: 16rpx;
  align-items: stretch;
  perspective: 900rpx;
}

.advanced-stage-set2 .advanced-proof-layer {
  inset: -14%;
  width: 128%;
  height: 128%;
}

.advanced-board-card,
.advanced-proof-card {
  min-height: 430rpx;
  border-radius: 12rpx;
  background: rgba(15, 8, 5, 0.68);
  border: 1rpx solid rgba(230, 168, 23, 0.12);
  position: relative;
}

.advanced-card-head {
  height: 94rpx;
  padding: 12rpx 18rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.03);
}

.advanced-title-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  align-items: center;
}

.advanced-board-title {
  max-width: 100%;
  font-size: 25rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.advanced-board-sub {
  max-width: 100%;
  font-size: 18rpx;
  color: rgba(255, 247, 230, 0.4);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.advanced-board-slot {
  height: 368rpx;
  margin: 0 14rpx 14rpx;
  border-radius: 8rpx;
  border: 1rpx dashed rgba(230, 168, 23, 0.22);
  background:
    linear-gradient(120deg, rgba(255, 247, 230, 0.05), transparent 42%),
    #1b1009;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.advanced-slot-filled {
  border-style: solid;
  background: #1b1009;
}

.advanced-board-img {
  width: 92%;
  height: 92%;
  transform-origin: center center;
  transition: transform 0.24s ease, opacity 0.24s ease;
}

.advanced-board-moving {
  animation: advancedBoardMoveIn 0.28s cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes advancedBoardMoveIn {
  0% {
    opacity: 0;
    transform: translateY(34rpx) scale(0.92);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.advanced-slot-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  color: rgba(255, 247, 230, 0.28);
}

.advanced-slot-empty-mark {
  width: 74rpx;
  height: 74rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(230, 168, 23, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.advanced-slot-empty-mark-text {
  font-size: 32rpx;
  color: rgba(230, 168, 23, 0.52);
}

.advanced-slot-empty-text {
  font-size: 21rpx;
  letter-spacing: 2rpx;
}

.advanced-proof-head {
  height: 72rpx;
  padding: 14rpx 18rpx 10rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.advanced-proof-title {
  font-size: 24rpx;
  color: #fff7e6;
  font-weight: 500;
}

.advanced-proof-count {
  font-size: 20rpx;
  color: rgba(242, 201, 76, 0.68);
  font-family: 'Courier New', monospace;
}

.advanced-proof-complete {
  border-color: rgba(215, 165, 61, 0.48);
  box-shadow: inset 0 0 0 1rpx rgba(215, 165, 61, 0.1);
}

.advanced-proof-complete .advanced-proof-title {
  color: #f2c94c;
}

.advanced-proof-paper {
  height: 356rpx;
  margin: 28rpx 20rpx 16rpx 32rpx;
  position: relative;
  border-radius: 8rpx;
  background:
    linear-gradient(90deg, rgba(80, 35, 10, 0.04), transparent 28%, rgba(255, 255, 255, 0.08) 50%, transparent 72%, rgba(80, 35, 10, 0.04)),
    #F3E4C4;
  border: 1rpx solid rgba(77, 35, 13, 0.25);
  overflow: hidden;
  transform-origin: left center;
  transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  will-change: transform;
  z-index: 3;
  backface-visibility: visible;
  transform-style: preserve-3d;
}

.advanced-paper-armed {
  border-color: rgba(230, 168, 23, 0.62);
  box-shadow: 0 14rpx 34rpx rgba(0, 0, 0, 0.26);
}

.advanced-paper-dragging {
  transition: none;
}

.advanced-paper-snap {
  box-shadow: 0 18rpx 40rpx rgba(212, 47, 47, 0.18);
}


.advanced-paper-back {
  position: absolute;
  inset: 0;
  z-index: 14;
  opacity: 0;
  pointer-events: none;
  background:
    linear-gradient(90deg, rgba(100, 52, 18, 0.08), transparent 28%, rgba(255, 255, 255, 0.22) 48%, transparent 70%, rgba(100, 52, 18, 0.08)),
    #E9D8B8;
  transition: opacity 0.12s ease;
}

.advanced-paper-back-fiber {
  position: absolute;
  inset: 0;
  background:
    repeating-linear-gradient(
      0deg,
      rgba(112, 77, 42, 0.06),
      rgba(112, 77, 42, 0.06) 1rpx,
      transparent 1rpx,
      transparent 7rpx
    ),
    repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.08),
      rgba(255, 255, 255, 0.08) 1rpx,
      transparent 1rpx,
      transparent 11rpx
    );
}

.advanced-paper-back-visible .advanced-paper-back {
  opacity: 1;
}

.advanced-paper-back-visible .advanced-proof-layer,
.advanced-paper-back-visible .advanced-proof-empty {
  opacity: 0;
}

.advanced-proof-layer {
  position: absolute;
  inset: -3%;
  width: 106%;
  height: 106%;
  opacity: 0;
  transition: opacity 0.24s ease, transform 0.24s ease;
  transform: scale(1.02);
  mix-blend-mode: multiply;
}

.advanced-layer-visible {
  opacity: 0.94;
  transform: scale(1);
}

.advanced-proof-empty {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.advanced-proof-empty-text {
  font-size: 21rpx;
  color: rgba(80, 35, 10, 0.42);
  letter-spacing: 1rpx;
}

.advanced-board-tray {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 16rpx;
}

.advanced-board-thumb {
  min-width: 0;
  height: 176rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.04);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 10rpx;
  box-sizing: border-box;
  transition: transform 0.2s ease, opacity 0.2s ease, border-color 0.2s ease, background 0.2s ease;
}

.advanced-board-thumb:active {
  transform: translateY(2rpx) scale(0.98);
}

.advanced-thumb-empty {
  opacity: 0.88;
  border-color: var(--advanced-color);
  background: rgba(255, 255, 255, 0.02);
}

.advanced-thumb-frame {
  position: relative;
  width: auto;
  height: 154rpx;
  min-width: 0;
  flex: 1;
  border-radius: 6rpx;
  background: rgba(15, 8, 5, 0.62);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  perspective: 420rpx;
}

.advanced-thumb-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.advanced-thumb-turn {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  animation: advancedThumbAutoTurn 7.6s linear infinite;
}

.advanced-thumb-turn-1 { animation-delay: -1.9s; }
.advanced-thumb-turn-2 { animation-delay: -3.8s; }
.advanced-thumb-turn-3 { animation-delay: -5.7s; }

.advanced-thumb-depth {
  filter: brightness(0.48) sepia(0.35);
}

.advanced-thumb-depth-back {
  transform: translateZ(-7rpx) translateX(5rpx);
  opacity: 0.62;
}

.advanced-thumb-depth-mid {
  transform: translateZ(-3rpx) translateX(2rpx);
  opacity: 0.78;
}

.advanced-thumb-front {
  transform: translateZ(2rpx);
  backface-visibility: hidden;
}

.advanced-thumb-placed-badge {
  position: absolute;
  left: 6rpx;
  bottom: 6rpx;
  z-index: 6;
  padding: 2rpx 8rpx;
  background: rgba(15, 8, 5, 0.82);
  border: 1rpx solid var(--advanced-color);
  border-radius: 3rpx;
}

.advanced-thumb-placed-badge-text {
  color: #fff7e6;
  font-size: 15rpx;
}

@keyframes advancedThumbAutoTurn {
  from { transform: rotateY(0deg); }
  to { transform: rotateY(360deg); }
}

.advanced-thumb-placeholder {
  width: 100%;
  height: 100%;
  border: 1rpx dashed rgba(255, 247, 230, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.advanced-thumb-placeholder-text {
  font-size: 18rpx;
  color: rgba(255, 247, 230, 0.34);
}

.advanced-thumb-check {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: rgba(15, 8, 5, 0.72);
  border: 1rpx solid rgba(242, 201, 76, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
}

.advanced-thumb-check-text {
  font-size: 18rpx;
  color: #F2C94C;
  font-weight: 700;
}

.advanced-thumb-name {
  font-size: 23rpx;
  color: rgba(255, 247, 230, 0.82);
  white-space: nowrap;
}

.advanced-thumb-copy {
  width: 58rpx;
  flex: 0 0 58rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.advanced-thumb-state {
  font-size: 16rpx;
  color: rgba(215, 165, 61, 0.68);
  white-space: nowrap;
}

.advanced-thumb-printed .advanced-thumb-name {
