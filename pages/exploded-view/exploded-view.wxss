/* ═══════════ 页面基础 ═══════════ */
page {
  background: #17110d;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.exploded-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: radial-gradient(ellipse at 50% 35%, rgba(196, 30, 58, 0.12), transparent 60%),
              linear-gradient(180deg, #1e1510 0%, #17110d 100%);
}

/* ═══════════ 顶栏 ═══════════ */
.top-bar {
  position: relative;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 54rpx 28rpx 16rpx;
  flex-shrink: 0;
}

.top-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 247, 230, 0.15);
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.35);
  flex-shrink: 0;
}

.top-back-icon {
  color: #fff7e6;
  font-size: 48rpx;
  line-height: 1;
  margin-top: -2rpx;
}

.top-title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
}

.top-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.top-title {
  color: #fff7e6;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  line-height: 1.3;
}

/* AI生成标识徽章 */
.ai-tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: linear-gradient(135deg, rgba(196, 30, 58, 0.9), rgba(230, 168, 23, 0.9));
  color: #fff7e6;
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 1.6;
}

.top-subtitle {
  color: rgba(255, 241, 207, 0.45);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.top-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.top-action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(255, 247, 230, 0.06);
  border: 1rpx solid rgba(255, 247, 230, 0.1);
}

.top-action-icon {
  color: rgba(255, 247, 230, 0.75);
  font-size: 32rpx;
  line-height: 1;
}

/* ═══════════ 加载态 ═══════════ */
.loading-panel {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(23, 17, 13, 0.75);
}

.loading-ring {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(255, 241, 207, 0.12);
  border-top-color: #e6a817;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 28rpx;
  color: rgba(255, 247, 230, 0.82);
  font-size: 28rpx;
}

/* ═══════════ 3D 视角区 ═══════════ */
.stage-zone {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  min-height: 0;
  transition: transform 0.25s ease, opacity 0.25s ease;
}

.stage-zone.slide-out-left {
  transform: translateX(-60rpx);
  opacity: 0;
}
.stage-zone.slide-out-right {
  transform: translateX(60rpx);
  opacity: 0;
}
.stage-zone.slide-in-left {
  transform: translateX(-60rpx);
  opacity: 0;
}
.stage-zone.slide-in-right {
  transform: translateX(60rpx);
  opacity: 0;
}

.stage {


  position: relative;
  width: 82vw;
  height: 82vw;
  display: flex;
  align-items: center;
  justify-content: center;
  perspective: 1200px;
}

.layers-container {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 0.18s ease-out;
}

/* 纸张背景 */
.paper-backdrop {
  position: absolute;
  inset: 0;
  z-index: 0;
  background: linear-gradient(135deg, #fdf5e6 0%, #f5e6d3 50%, #ede0cc 100%);
  border-radius: 6rpx;
  box-shadow:
    0 4rpx 0 rgba(180, 155, 125, 0.3),
    0 18rpx 54rpx rgba(0, 0, 0, 0.32);
  transition: transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 图层图片 */
.layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  transition: transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1),
              opacity 0.35s ease;
  opacity: 0.9;
}

.layer-hidden {
  opacity: 0 !important;
  transition: opacity 0.25s ease;
}

.layer-highlight {
  opacity: 1 !important;
  filter: brightness(1.15);
  transition: filter 0.2s ease, opacity 0.2s ease;
}

/* ═══════════ 左右切换箭头 ═══════════ */
.arrow-btn {
  position: fixed;
  top: 50%;
  transform: translateY(-50%);
  z-index: 40;
  width: 68rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.25);
  border: 1rpx solid rgba(255, 247, 230, 0.06);
}

.arrow-left {
  left: 8rpx;
  border-radius: 0 16rpx 16rpx 0;
}

.arrow-right {
  right: 8rpx;
  border-radius: 16rpx 0 0 16rpx;
}

.arrow-icon {
  color: rgba(255, 247, 230, 0.55);
  font-size: 52rpx;
  line-height: 1;
}

/* ═══════════ 底部控制坞 ═══════════ */
.bottom-dock {
  position: relative;
  z-index: 50;
  flex-shrink: 0;
  padding: 0 0 env(safe-area-inset-bottom, 24rpx);
  background: linear-gradient(0deg, rgba(23, 17, 13, 0.98) 0%, rgba(23, 17, 13, 0.85) 70%, transparent 100%);
}

.dock-indicator {
  text-align: center;
  padding: 8rpx 0 4rpx;
}

.dock-indicator-text {
  color: rgba(255, 247, 230, 0.3);
  font-size: 20rpx;
  letter-spacing: 4rpx;
}

/* AI生成内容显著提示 */
.ai-content-notice {
  text-align: center;
  padding: 10rpx 24rpx 4rpx;
}

.ai-content-notice-text {
  display: inline-block;
  padding: 6rpx 20rpx;
  background: rgba(230, 168, 23, 0.12);
  border: 1rpx solid rgba(230, 168, 23, 0.25);
  border-radius: 8rpx;
  color: rgba(230, 168, 23, 0.9);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

/* ── 图层切换横条 ── */
.layer-toggle-strip {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx 8rpx 20rpx;
  gap: 12rpx;
}

.strip-label {
  flex-shrink: 0;
}

.strip-label-text {
  color: rgba(255, 247, 230, 0.4);
  font-size: 20rpx;
  letter-spacing: 2rpx;
  writing-mode: vertical-lr;
}

.strip-scroll {
  flex: 1;
  white-space: nowrap;
  height: 80rpx;
}

.strip-chips {
  display: inline-flex;
  gap: 12rpx;
  height: 80rpx;
  align-items: center;
  padding: 0 8rpx;
}

.layer-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 18rpx;
  border-radius: 28rpx;
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
  flex-shrink: 0;
}

.chip-on {
  background: rgba(255, 247, 230, 0.08);
  border-color: rgba(255, 247, 230, 0.12);
}

.chip-off {
  background: rgba(255, 247, 230, 0.03);
  border-color: rgba(255, 247, 230, 0.04);
  opacity: 0.5;
}

.chip-highlight {
  background: rgba(196, 30, 58, 0.2);
  border-color: rgba(196, 30, 58, 0.45);
  opacity: 1;
}

.chip-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 8rpx currentColor;
}

.chip-label {
  color: rgba(255, 247, 230, 0.85);
  font-size: 24rpx;
  white-space: nowrap;
}

.chip-off .chip-label {
  color: rgba(255, 247, 230, 0.35);
}

.chip-order {
  color: rgba(255, 247, 230, 0.25);
  font-size: 18rpx;
}

/* 批量操作 */
.strip-bulk {
  display: flex;
  gap: 6rpx;
  flex-shrink: 0;
}

.bulk-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 247, 230, 0.06);
  border: 1rpx solid rgba(255, 247, 230, 0.08);
}

.bulk-icon {
  color: rgba(255, 247, 230, 0.55);
  font-size: 28rpx;
}
