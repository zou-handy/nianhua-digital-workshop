<view class="exploded-page">
  <!-- ═══════════════ 顶栏：导航 + 标题 ═══════════════ -->
  <view class="top-bar">
    <view class="top-back" bindtap="goBack">
      <text class="top-back-icon">‹</text>
    </view>

    <view class="top-title-area">
      <view class="top-title-row">
        <text class="top-title">{{layers.length ? (layers.length + '色套印') : '分色套印'}}</text>
        <view class="ai-tag" wx:if="{{colorLayersList[currentIndex].isPreset === false}}">AI生成</view>
      </view>
      <text class="top-subtitle">佛山木版年画 · 数字分色</text>
    </view>

    <view class="top-actions">
      <view class="top-action-btn" bindtap="resetView">
        <text class="top-action-icon">↺</text>
      </view>
    </view>
  </view>

  <!-- ═══════════════ 加载态 ═══════════════ -->
  <view class="loading-panel" wx:if="{{loading}}">
    <view class="loading-ring"></view>
    <text class="loading-text">{{loadingText}}</text>
  </view>

  <!-- ═══════════════ 中心：3D 视角区 ═══════════════ -->
  <view
    class="stage-zone {{slideDirection}}"
    wx:if="{{layers.length > 0}}"
  >
    <view
      class="stage"
      bindtap="onStageTap"
      bindlongpress="onStageLongPress"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
      bindtouchcancel="onTouchEnd"
    >
      <view
        class="layers-container"
        style="transform: rotateX({{rotateX}}deg) rotateZ({{rotateZ}}deg) scale({{scale}});"
      >
        <!-- 纸张背景 -->
        <view
          class="paper-backdrop"
          style="transform: {{isExploded ? 'translateZ(-240px) translateY(96px)' : 'translateZ(0px) translateY(0px)'}};"
        ></view>

        <!-- 图层 -->
        <image
          wx:for="{{layers}}"
          wx:key="index"
          class="layer {{item.visible === false ? 'layer-hidden' : ''}} {{highlightedLayer === index ? 'layer-highlight' : ''}}"
          src="{{item.tempPath}}"
          mode="aspectFit"
          style="{{item.layerStyle}}"
        ></image>
      </view>
    </view>
  </view>

  <!-- ═══════════════ 左右切换箭头 ═══════════════ -->
  <view class="arrow-btn arrow-left" wx:if="{{!loading && currentIndex > 0}}" bindtap="prevItem">
    <text class="arrow-icon">‹</text>
  </view>
  <view class="arrow-btn arrow-right" wx:if="{{!loading && currentIndex < colorLayersList.length - 1}}" bindtap="nextItem">
    <text class="arrow-icon">›</text>
  </view>

  <!-- ═══════════════ 底部：图层控制条 ═══════════════ -->
  <view class="bottom-dock" wx:if="{{!loading && layers.length > 0}}">
    <!-- AI生成内容提示 -->
    <view class="ai-content-notice" wx:if="{{colorLayersList[currentIndex].isPreset === false}}">
      <text class="ai-content-notice-text">当前作品由人工智能（AI）生成，仅供参考</text>
    </view>

    <!-- 作品指示器 -->
    <view class="dock-indicator" wx:if="{{colorLayersList.length > 1}}">
      <text class="dock-indicator-text">{{currentIndex + 1}} / {{colorLayersList.length}}</text>
    </view>

    <!-- 图层可见性开关横条 -->
    <view class="layer-toggle-strip">
      <view class="strip-label">
        <text class="strip-label-text">套色层</text>
      </view>

      <scroll-view class="strip-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="strip-chips">
          <view
            wx:for="{{layers}}"
            wx:key="index"
            class="layer-chip {{layerVisibility[index] === false ? 'chip-off' : 'chip-on'}} {{highlightedLayer === index ? 'chip-highlight' : ''}}"
            data-index="{{index}}"
            bindtap="toggleLayerVisibility"
            bindlongpress="onLayerLongPress"
            bindtouchend="onLayerTouchEnd"
          >
            <view class="chip-dot" style="background: {{item.color || '#888'}};"></view>
            <text class="chip-label">{{item.label || ('图层' + (index + 1))}}</text>
            <text class="chip-order">#{{index + 1}}</text>
          </view>
        </view>
      </scroll-view>

      <!-- 全部显示/隐藏 -->
      <view class="strip-bulk">
        <view class="bulk-btn" bindtap="showAllLayers">
          <text class="bulk-icon">☉</text>
        </view>
        <view class="bulk-btn" bindtap="hideAllLayers">
          <text class="bulk-icon">◎</text>
        </view>
      </view>
    </view>
  </view>

  <ai-float id="aiFloat"></ai-float>
</view>
