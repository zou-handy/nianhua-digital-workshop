/* 悬浮按钮 */
.ai-float-btn {
  position: fixed;
  width: 56px;
  height: 56px;
  z-index: 999;
  transition: opacity 0.3s ease;
}

.ai-tutorial-overlay {
  position: fixed;
  inset: 0;
  z-index: 1100;
}

.ai-tutorial-mask {
  position: fixed;
  background: rgba(5, 3, 2, 0.78);
}

.ai-tutorial-card {
  position: fixed;
  width: 270px;
  padding: 16px;
  box-sizing: border-box;
  background: #1c100a;
  border: 1px solid rgba(230, 168, 23, 0.7);
  border-radius: 6px;
  box-shadow: 0 12px 34px rgba(0, 0, 0, 0.5);
}

.ai-tutorial-kicker,
.ai-tutorial-title,
.ai-tutorial-text {
  display: block;
}

.ai-tutorial-kicker {
  color: #e6a817;
  font-size: 11px;
  letter-spacing: 2px;
}

.ai-tutorial-title {
  margin-top: 6px;
  color: #fff7e6;
  font-size: 18px;
  font-weight: 600;
}

.ai-tutorial-text {
  margin-top: 8px;
  color: rgba(255, 247, 230, 0.72);
  font-size: 13px;
  line-height: 1.6;
}

.ai-tutorial-actions {
  margin-top: 14px;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 18px;
}

.ai-tutorial-skip {
  color: rgba(255, 247, 230, 0.46);
  font-size: 12px;
}

.ai-tutorial-next {
  padding: 7px 16px;
  color: #1c100a;
  background: #e6a817;
  border-radius: 3px;
  font-size: 13px;
}

.ai-float-btn.hidden {
  opacity: 0;
  pointer-events: none;
}

.ai-float-btn.dragging {
  transition: none;
}

.ai-proactive-bubble {
  position: fixed;
  z-index: 998;
  box-sizing: border-box;
  padding: 12px 14px;
  border-radius: 8px;
  background: rgba(30, 20, 10, 0.96);
  border: 1px solid rgba(230, 168, 23, 0.34);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.34);
  animation: aiBubbleIn 0.22s ease-out;
}

.ai-proactive-text {
  display: block;
  color: rgba(255, 247, 230, 0.92);
  font-size: 13px;
  line-height: 1.55;
}

.ai-proactive-arrow {
  position: absolute;
  top: 19px;
  width: 10px;
  height: 10px;
  background: #1e140a;
  border-top: 1px solid rgba(230, 168, 23, 0.34);
  border-right: 1px solid rgba(230, 168, 23, 0.34);
}

.ai-proactive-left .ai-proactive-arrow {
  right: -6px;
  transform: rotate(45deg);
}

.ai-proactive-right .ai-proactive-arrow {
  left: -6px;
  transform: rotate(225deg);
}

@keyframes aiBubbleIn {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}

.ai-float-inner {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(135deg, #C41E3A 0%, #8B1525 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6px 20px rgba(196, 30, 58, 0.4), inset 0 0 0 2px rgba(255, 247, 230, 0.15);
  position: relative;
}

.ai-float-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.ai-float-pulse {
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  border: 2px solid rgba(196, 30, 58, 0.3);
  animation: aiPulse 2s ease-out infinite;
}

@keyframes aiPulse {
  0% { transform: scale(1); opacity: 0.6; }
  100% { transform: scale(1.4); opacity: 0; }
}

/* 聊天弹窗 */
.ai-chat-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.ai-chat-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.ai-chat-panel {
  width: 100%;
  max-height: 80vh;
  background: #0f0805;
  border-top: 1px solid rgba(230, 168, 23, 0.15);
  border-radius: 24px 24px 0 0;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1);
  box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.5);
}

.ai-chat-overlay.show .ai-chat-panel {
  transform: translateY(0);
}

/* 标题栏 */
.ai-panel-header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 20px;
  border-bottom: 1px solid rgba(230, 168, 23, 0.08);
  flex-shrink: 0;
}

.ai-panel-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: linear-gradient(135deg, #C41E3A, #E6A817);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: visible;
}

.ai-panel-avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.ai-avatar-switch {
  position: absolute;
  right: -4px;
  bottom: -3px;
  width: 17px;
  height: 17px;
  border-radius: 50%;
  background: #c41e3a;
  color: #fff7e6;
  border: 1px solid #0f0805;
  font-size: 11px;
  line-height: 17px;
  text-align: center;
}

.ai-panel-title-wrap {
  flex: 1;
}

.ai-panel-title-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.ai-panel-title {
  font-size: 16px;
  font-weight: 600;
  color: #fff7e6;
  display: block;
}

/* AI生成标识徽章 */
.ai-tag {
  display: inline-flex;
  align-items: center;
  padding: 1px 6px;
  border-radius: 4px;
  background: linear-gradient(135deg, rgba(196, 30, 58, 0.85), rgba(230, 168, 23, 0.85));
  color: #fff7e6;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.5px;
  line-height: 1.6;
}

.ai-panel-status {
  font-size: 11px;
  color: rgba(230, 168, 23, 0.55);
}

.ai-panel-close {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-close-icon {
  font-size: 14px;
  color: rgba(255, 247, 230, 0.5);
}

/* 消息区 */
.ai-panel-messages {
  flex: 1;
  min-height: 200px;
  max-height: 50vh;
  padding: 16px;
  box-sizing: border-box;
}

/* 欢迎页 */
.ai-welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30px 0;
  gap: 8px;
}

.ai-welcome-seal {
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff7e6;
  font-size: 20px;
  font-family: "STXingkai", "华文行楷", "KaiTi", cursive;
  border: 1px solid #c41e3a;
  background: rgba(196, 30, 58, 0.18);
}

.ai-welcome-text {
  font-size: 18px;
  font-weight: 500;
  color: #fff7e6;
}

.ai-welcome-desc {
  font-size: 12px;
  color: rgba(230, 168, 23, 0.5);
  margin-bottom: 16px;
}

.ai-tutorial-entry {
  width: 100%;
  min-height: 64px;
  margin: 6px 16px 10px;
  padding: 10px 12px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 10px;
  border: 1px solid rgba(196, 30, 58, 0.62);
  border-radius: 6px;
  background: rgba(87, 18, 25, 0.42);
}

.ai-tutorial-entry:active {
  opacity: 0.76;
}

.ai-tutorial-mark {
  width: 32px;
  height: 32px;
  flex: 0 0 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff7e6;
  border: 1px solid rgba(230, 168, 23, 0.55);
  font-size: 15px;
}

.ai-tutorial-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.ai-tutorial-title {
  color: #fff7e6;
  font-size: 14px;
}

.ai-tutorial-desc {
  color: rgba(255, 247, 230, 0.55);
  font-size: 11px;
  line-height: 1.45;
}

.ai-tutorial-arrow {
  color: #e6a817;
  font-size: 24px;
}

/* AI生成内容显著提示 */
.ai-welcome-notice {
  width: 100%;
  padding: 8px 12px;
  margin: 0 16px 16px;
  box-sizing: border-box;
  background: rgba(230, 168, 23, 0.1);
  border: 1px solid rgba(230, 168, 23, 0.22);
  border-radius: 8px;
  font-size: 11px;
  color: rgba(230, 168, 23, 0.85);
  text-align: center;
  letter-spacing: 0.5px;
}

.ai-suggestions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 0 16px;
  box-sizing: border-box;
}

.ai-suggestion {
  padding: 10px 14px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(230, 168, 23, 0.1);
  text-align: center;
}

.ai-suggestion:active {
  background: rgba(196, 30, 58, 0.1);
}

.ai-suggestion-text {
  font-size: 13px;
  color: rgba(255, 247, 230, 0.7);
}

/* 消息气泡 */
.ai-msg {
  display: flex;
  margin-bottom: 12px;
}

.ai-msg-user {
  justify-content: flex-end;
}

.ai-msg-bot {
  justify-content: flex-start;
  flex-direction: column;
  align-items: flex-start;
}

/* 单条AI消息生成标识 */
.ai-msg-label {
  font-size: 10px;
  color: rgba(230, 168, 23, 0.55);
  margin-top: 4px;
  margin-left: 2px;
  letter-spacing: 0.5px;
}

.ai-msg-bubble {
  max-width: 80%;
  padding: 10px 14px;
  border-radius: 16px;
}

.ai-bubble-user {
  background: linear-gradient(135deg, #C41E3A, #8B1525);
  border-bottom-right-radius: 4px;
}

.ai-bubble-bot {
  background: rgba(30, 20, 10, 0.85);
  border: 1px solid rgba(230, 168, 23, 0.12);
  border-bottom-left-radius: 4px;
}

.ai-msg-text {
  font-size: 14px;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.ai-bubble-user .ai-msg-text {
  color: #fff7e6;
}

.ai-bubble-bot .ai-msg-text {
  color: rgba(255, 247, 230, 0.85);
}

/* 打字指示器 */
.ai-typing {
  display: flex;
  gap: 4px;
  padding: 4px 0;
}

.ai-typing-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: rgba(230, 168, 23, 0.5);
  animation: aiTyping 1.4s ease-in-out infinite;
}

.ai-typing-dot:nth-child(2) { animation-delay: 0.2s; }
.ai-typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes aiTyping {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-4px); opacity: 1; }
}

.ai-msg-bottom {
  height: 60px;
}

/* 输入区 */
.ai-panel-input {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px 24px;
  border-top: 1px solid rgba(230, 168, 23, 0.06);
  flex-shrink: 0;
}

.ai-input {
  flex: 1;
  height: 36px;
  padding: 0 14px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(230, 168, 23, 0.1);
  border-radius: 18px;
  font-size: 14px;
  color: #fff7e6;
}

.ai-input-ph {
  color: rgba(255, 247, 230, 0.3);
}

.ai-send {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ai-send.active {
  background: linear-gradient(135deg, #C41E3A, #8B1525);
}

.ai-send-icon {
  font-size: 16px;
  color: rgba(255, 247, 230, 0.5);
}

.ai-send.active .ai-send-icon {
  color: #fff7e6;
}
